{
  "name": "website-powerracing",
  "version": "1.0.0",
  "description": "Power Racing Complete Application",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:admin\"",
    "start:backend": "cd powerRacingBackend && npm start",
    "start:frontend": "cd power && npm start",
    "start:admin": "cd power-racing-admin && PORT=3001 npm start",
    "install:all": "npm install && npm run install:backend && npm run install:frontend && npm run install:admin",
    "install:backend": "cd powerRacingBackend && npm install",
    "install:frontend": "cd power && npm install",
    "install:admin": "cd power-racing-admin && npm install",
    "start:admin-stack": "concurrently \"npm run start:backend\" \"npm run start:admin\"",
    "start:public-stack": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolamaraschi/website-powerRacing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nicolamaraschi/website-powerRacing/issues"
  },
  "homepage": "https://github.com/nicolamaraschi/website-powerRacing#readme",
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}